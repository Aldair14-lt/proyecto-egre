<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="ejemplo" 
              pageWidth="595" 
              pageHeight="842" 
              columnWidth="555" 
              leftMargin="20" 
              rightMargin="20" 
              topMargin="20" 
              bottomMargin="20">

    <!-- Declaración de parámetros que se enviarán dinámicamente desde Java -->
    <parameter name="TITULO_REPORTE" class="java.lang.String"/>
    <parameter name="USUARIO_IMPRESION" class="java.lang.String"/>

    <!-- Banda de Título: Se muestra únicamente en la primera página del documento -->
    <title>
        <band height="80">
            <!-- Texto dinámico (recibe el valor del parámetro TITULO_REPORTE) -->
            <textField>
                <reportElement x="0" y="10" width="555" height="35"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="18" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{TITULO_REPORTE}]]></textFieldExpression>
            </textField>

            <!-- Texto dinámico de subtítulo con nombre de usuario -->
            <textField>
                <reportElement x="0" y="50" width="555" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="10" isItalic="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Generado por: " + $P{USUARIO_IMPRESION}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <!-- Banda de Detalle: Contenido principal del reporte -->
    <detail>
        <band height="100">
            <!-- Rectángulo decorativo / Marco de contenido -->
            <rectangle radius="5">
                <reportElement x="20" y="10" width="515" height="70"/>
            </rectangle>

            <!-- Texto estático informativo dentro del cuadro -->
            <staticText>
                <reportElement x="30" y="20" width="495" height="50"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="12" isBold="false"/>
                </textElement>
                <text><![CDATA[¡Integración exitosa de JasperReports con Spring Boot y Java 21!
Este es un reporte generado dinámicamente desde el backend.]]></text>
            </staticText>
        </band>
    </detail>

    <!-- Banda de Pie de Página: Se repite al final de cada página -->
    <pageFooter>
        <band height="30">
            <line>
                <reportElement x="0" y="0" width="555" height="1"/>
            </line>
            <staticText>
                <reportElement x="0" y="5" width="555" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <text><![CDATA[Ministerio Público - Sistema de Reportes Internos]]></text>
            </staticText>
        </band>
    </pageFooter>

</jasperReport>